{"specVersion": "1.0", "type": "springboot", "metadata": {"title": "Employee Management (Spring Boot)", "branch": "feat/employee-management-java", "date": "2026-08-17"}, "summary": "Java/Spring Boot port of the employee-management test project, mirroring the existing express-drizzle version's entities (employee, department, user, time-off-request, employee-document) so the same EMP-1/EMP-2/EMP-3 test tickets apply unchanged.", "technicalContext": {"language": "Java 21", "primaryDependencies": ["Spring Boot 3.x", "Spring Web", "Spring Data JPA", "Flyway"], "storage": "PostgreSQL 16", "testing": ["JUnit 5", "MockMvc", "Testcontainers"], "constraints": "No ddl-auto in production; all schema changes via Flyway migrations."}, "authorizationPolicies": [{"role": "ROLE_ADMIN", "permissions": ["create", "read", "update", "delete"], "description": "Full access, matches the Express version's single ROLE_ADMIN user role."}], "entities": [{"name": "Department", "table": "departments", "fields": [{"name": "id", "type": "UUID", "primaryKey": true, "generated": true}, {"name": "name", "type": "String", "notNull": true, "unique": true, "constraints": ["not_blank", "max:120"]}, {"name": "createdAt", "type": "Instant", "audit": "created"}, {"name": "updatedAt", "type": "Instant", "audit": "updated"}], "apiDoc": {"tag": "Departments", "description": "Organizational departments employees belong to."}}, {"name": "Employee", "table": "employees", "fields": [{"name": "id", "type": "UUID", "primaryKey": true, "generated": true}, {"name": "firstName", "type": "String", "notNull": true, "constraints": ["not_blank", "max:80"]}, {"name": "lastName", "type": "String", "notNull": true, "constraints": ["not_blank", "max:80"]}, {"name": "email", "type": "String", "notNull": true, "unique": true, "constraints": ["not_blank", "pattern:^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"]}, {"name": "jobTitle", "type": "String", "notNull": true, "constraints": ["not_blank", "max:120"]}, {"name": "hireDate", "type": "Local